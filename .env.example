# Volcengine Ark image generation
# Create this in the Volcengine Ark console: API Key 管理
ARK_API_KEY=

# Optional overrides
ARK_IMAGE_MODEL=doubao-seedream-4-0-250828
ARK_API_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations

# Generic Volcengine AK/SK can work for some Volcengine OpenAPI services
# and for parts of the Ark SDK, but the Ark Runtime images.generate method
# currently requires ARK_API_KEY in the official Python SDK.
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=
